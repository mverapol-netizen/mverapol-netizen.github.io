---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueCover from '../../components/IssueCover.astro';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL;
const numeros=(await getCollection('numeros',({data})=>!data.draft&&data.status!=='proximo')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Archivo" active="Archivo" noindex={numeros.length===0}>
<header class="page-head"><span class="label">Hemeroteca</span><h1>Archivo</h1><p>Los números publicados por La Forja.</p></header>
<section class="issue-shelf">
  {numeros.length===0 && <article class="card"><h2>Archivo en preparación</h2><p>La primera edición aún no se publica. Aquí estarán disponibles nuestros números cuando comience la revista.</p><a class="text-link" href={base+'sobre/'}>Conoce la revista →</a></article>}
  {numeros.map(n=><IssueCover number={n.data.number} year={n.data.year} month={n.data.month} title={n.data.coverTitle} style={n.data.coverStyle} href={base+'archivo/'+n.id+'/'}/>)}
</section>
</BaseLayout>
