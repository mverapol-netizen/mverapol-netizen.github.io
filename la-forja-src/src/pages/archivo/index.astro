---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueCover from '../../components/IssueCover.astro';
import{getCollection}from'astro:content';
const base=import.meta.env.BASE_URL;
const numeros=(await getCollection('numeros',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Archivo" active="Archivo"><header class="page-head"><span class="label">Hemeroteca</span><h1>Archivo</h1><p>La memoria acumulada de La Forja: números, autores, temas y cuadernos.</p></header><section class="issue-shelf">{numeros.map(n=><IssueCover number={n.data.number} year={n.data.year} month={n.data.month} title={n.data.coverTitle} style={n.data.coverStyle} href={base+'archivo/'+n.id+'/'}/>)}</section></BaseLayout>