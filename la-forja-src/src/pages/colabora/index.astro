---
import BaseLayout from '../../layouts/BaseLayout.astro';
const supabaseUrl='https://jtgoumydocaleucuomaw.supabase.co';
const supabaseKey='sb_publishable_jHVTZ5v1aeP82CxMg33r6g_S3C_yG9H';
---
<BaseLayout title="Publica con nosotros">
  <header class="submission-hero">
    <span>Convocatoria editorial</span>
    <h1>Publica con nosotros</h1>
    <p>La Forja quiere ser un espacio de escritura, discusión y formación de las izquierdas. Recibimos propuestas de personas que quieran intervenir con argumentos, abrir debates o producir materiales de educación popular.</p>
  </header>

  <section class="submission-types">
    <article><strong>01</strong><h2>Columnas</h2><p>Intervenciones breves sobre política, sociedad, cultura y coyuntura.</p></article>
    <article><strong>02</strong><h2>Ensayos</h2><p>Textos de mayor extensión, con una tesis clara y desarrollo argumentativo.</p></article>
    <article><strong>03</strong><h2>Debates</h2><p>Propuestas para iniciar o responder discusiones relevantes para las izquierdas.</p></article>
    <article><strong>04</strong><h2>Educación popular</h2><p>Materiales accesibles y rigurosos sobre conceptos, historia, lecturas y herramientas.</p></article>
  </section>

  <section class="submission-form-section">
    <div class="submission-form-intro">
      <span class="label blue">Enviar propuesta</span>
      <h2>Queremos leerte</h2>
      <p>Completa este formulario y adjunta tu manuscrito en Word. El archivo queda almacenado de forma privada para revisión editorial y nunca se publica automáticamente.</p>
      <p class="form-note">Formato: <strong>.docx</strong> · máximo 10 MB. Extraemos una copia de texto para poder leer y revisar el manuscrito dentro de la mesa editorial, pero conservamos intacto el Word original.</p>
    </div>

    <form id="submission-form" class="submission-form" novalidate>
      <div class="form-grid">
        <label>
          <span>Nombre completo *</span>
          <input name="name" type="text" minlength="2" maxlength="160" required autocomplete="name" />
        </label>
        <label>
          <span>Correo electrónico *</span>
          <input name="email" type="email" maxlength="254" required autocomplete="email" />
        </label>
        <label>
          <span>Tipo de colaboración *</span>
          <select name="contribution_type" required>
            <option value="">Selecciona una opción</option>
            <option value="columna">Columna</option>
            <option value="ensayo">Ensayo</option>
            <option value="debate">Propuesta de debate</option>
            <option value="educacion-popular">Educación popular</option>
            <option value="otro">Otro</option>
          </select>
        </label>
        <label>
          <span>Título del texto *</span>
          <input name="title" type="text" minlength="3" maxlength="240" required />
        </label>
      </div>

      <label>
        <span>Resumen de la propuesta *</span>
        <textarea name="summary" minlength="20" maxlength="2000" rows="5" required placeholder="¿Cuál es la pregunta, tesis o problema central del texto?"></textarea>
      </label>

      <label>
        <span>Breve biografía *</span>
        <textarea name="bio" minlength="10" maxlength="1200" rows="4" required placeholder="Cuéntanos brevemente quién eres y desde dónde escribes."></textarea>
      </label>

      <label class="word-upload">
        <span>Manuscrito en Word *</span>
        <input id="manuscript-file" name="manuscript_file" type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required />
        <span class="word-upload-help">Selecciona un archivo .docx de hasta 10 MB.</span>
        <span id="word-file-status" class="word-file-status" aria-live="polite"></span>
      </label>

      <label>
        <span>Nota adicional</span>
        <textarea name="notes" maxlength="2000" rows="4" placeholder="Opcional: contexto, vínculos con otros debates o información útil para la edición."></textarea>
      </label>

      <div class="form-honeypot" aria-hidden="true">
        <label>Tu sitio web<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="form-checks">
        <label><input name="originality_confirmed" type="checkbox" required /> <span>Declaro que el texto es original y que puedo autorizar su publicación.</span></label>
        <label><input name="editorial_changes_accepted" type="checkbox" required /> <span>Acepto que La Forja pueda proponer cambios editoriales antes de publicar.</span></label>
        <label><input name="privacy_accepted" type="checkbox" required /> <span>Acepto que estos datos y el archivo se almacenen únicamente para gestionar esta propuesta editorial.</span></label>
      </div>

      <div class="form-submit-row">
        <button type="submit">Enviar propuesta →</button>
        <div id="submission-status" class="submission-status" role="status" aria-live="polite"></div>
      </div>
    </form>
  </section>

  <section class="submission-process">
    <div class="prose">
      <h2>Qué ocurre después</h2>
      <p>La publicación es editorialmente curada. Los textos no aparecen de manera automática: La Forja los revisa, conversa eventuales cambios con sus autores y decide su publicación.</p>
      <p>El envío del formulario confirma recepción técnica, pero no implica aceptación editorial.</p>
    </div>
    <aside>
      <span>Principio editorial</span>
      <strong>No buscamos uniformidad. Buscamos argumentos, discusión y pensamiento crítico.</strong>
      <p>La firma de un texto expresa la posición de su autor o autora, no necesariamente la de la revista.</p>
    </aside>
  </section>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.2"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/mammoth@1.13.0/mammoth.browser.min.js"></script>
  <script define:vars={{supabaseUrl,supabaseKey}}>
    const form=document.getElementById('submission-form');
    const status=document.getElementById('submission-status');
    const fileStatus=document.getElementById('word-file-status');
    const fileInput=document.getElementById('manuscript-file');
    const button=form.querySelector('button[type="submit"]');
    const client=window.supabase.createClient(supabaseUrl,supabaseKey,{
      auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false}
    });
    const DOCX_MIME='application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    const MAX_FILE_SIZE=10*1024*1024;

    async function extractWordText(file){
      const buffer=await file.arrayBuffer();
      const result=await window.mammoth.extractRawText({arrayBuffer:buffer});
      return String(result.value||'').trim();
    }

    fileInput.addEventListener('change',async()=>{
      fileStatus.className='word-file-status';
      fileStatus.textContent='';
      const file=fileInput.files?.[0];
      if(!file)return;
      if(!file.name.toLowerCase().endsWith('.docx')){
        fileInput.value='';
        fileStatus.classList.add('error');
        fileStatus.textContent='El archivo debe estar en formato .docx.';
        return;
      }
      if(file.size>MAX_FILE_SIZE){
        fileInput.value='';
        fileStatus.classList.add('error');
        fileStatus.textContent='El archivo supera el máximo de 10 MB.';
        return;
      }
      fileStatus.textContent=`${file.name} · ${(file.size/1024/1024).toFixed(2)} MB`;
    });

    form.addEventListener('submit',async(event)=>{
      event.preventDefault();
      status.className='submission-status';
      status.textContent='';

      if(!form.reportValidity())return;
      const data=new FormData(form);

      if(String(data.get('website')||'').trim()!==''){
        form.reset();
        fileStatus.textContent='';
        status.classList.add('success');
        status.textContent='Propuesta recibida.';
        return;
      }

      const file=fileInput.files?.[0];
      if(!file||!file.name.toLowerCase().endsWith('.docx')||file.size>MAX_FILE_SIZE){
        status.classList.add('error');
        status.textContent='Selecciona un archivo Word .docx válido de hasta 10 MB.';
        return;
      }

      button.disabled=true;
      button.textContent='Procesando Word…';
      status.textContent='Preparando una copia de lectura del manuscrito…';

      try{
        const manuscript=await extractWordText(file);
        if(manuscript.length<100)throw new Error('word_too_short');
        if(manuscript.length>120000)throw new Error('word_too_long');

        const id=crypto.randomUUID();
        const filePath=`${id}/manuscrito.docx`;

        button.textContent='Subiendo Word…';
        status.textContent='Guardando el archivo original de forma privada…';

        const {error:uploadError}=await client.storage
          .from('editorial-manuscripts')
          .upload(filePath,file,{contentType:DOCX_MIME,upsert:false,cacheControl:'3600'});

        if(uploadError)throw uploadError;

        const payload={
          id,
          name:String(data.get('name')||'').trim(),
          email:String(data.get('email')||'').trim(),
          contribution_type:String(data.get('contribution_type')||''),
          title:String(data.get('title')||'').trim(),
          summary:String(data.get('summary')||'').trim(),
          bio:String(data.get('bio')||'').trim(),
          manuscript,
          manuscript_file_path:filePath,
          manuscript_file_name:file.name,
          manuscript_file_size:file.size,
          notes:String(data.get('notes')||'').trim()||null,
          originality_confirmed:data.get('originality_confirmed')==='on',
          editorial_changes_accepted:data.get('editorial_changes_accepted')==='on',
          privacy_accepted:data.get('privacy_accepted')==='on',
          source:'la-forja-web-docx'
        };

        button.textContent='Enviando…';
        status.textContent='Registrando tu propuesta editorial…';

        const {error:insertError}=await client
          .from('editorial_submissions')
          .insert(payload);

        if(insertError)throw insertError;

        form.reset();
        fileStatus.textContent='';
        status.classList.add('success');
        status.textContent='Propuesta recibida. El Word quedó guardado para revisión editorial.';
      }catch(error){
        console.error(error);
        status.classList.add('error');
        if(error?.message==='word_too_short')status.textContent='No pudimos extraer suficiente texto del Word. Revisa que el archivo contenga el manuscrito y vuelve a intentarlo.';
        else if(error?.message==='word_too_long')status.textContent='El manuscrito supera el máximo de texto admitido para la vista editorial.';
        else status.textContent='No pudimos recibir el Word. Intenta nuevamente en unos minutos.';
      }finally{
        button.disabled=false;
        button.textContent='Enviar propuesta →';
      }
    });
  </script>
</BaseLayout>