---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialArt from '../components/EditorialArt.astro';
import DeclaracionEditorial from '../components/DeclaracionEditorial.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const articulos=await getCollection('articulos',({data})=>!data.draft);
const autores=await getCollection('autores',({data})=>!data.draft);
const authorName=(id)=>autores.find(a=>a.id===id)?.data.name??id;
const featured=articulos.find(a=>a.data.featured)??articulos[0];
const columnas=articulos.filter(a=>a.data.type==='columna').sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const cuadernos=(await getCollection('cuadernos',({data})=>!data.draft)).sort((a,b)=>a.data.number-b.data.number).slice(0,4);
const hrefFor=(a)=>base+(a.data.type==='ensayo'?'ensayos/':'columnas/')+a.id+'/';
---
<BaseLayout active="Portada" description="La Forja, revista digital independiente de pensamiento crítico, opinión, ensayo y educación popular. Primera convocatoria editorial.">
  {featured ? (
    <section class="hero">
      <div>
        <span class="label blue">{featured.data.type}</span>
        <h1>{featured.data.title}</h1>
        <div class="dek">{featured.data.subtitle}</div>
        <div class="byline">Por {authorName(featured.data.author)}</div>
        <a class="text-link" href={hrefFor(featured)}>Leer publicación →</a>
      </div>
      <EditorialArt style={featured.data.artStyle} label={featured.data.artLabel} alt={featured.data.title} href={hrefFor(featured)} image={featured.data.image} imageAlt={featured.data.imageAlt} imageTreatment={featured.data.imageTreatment}/>
    </section>
  ) : (
    <section class="hero">
      <div>
        <span class="label blue">Primera convocatoria editorial</span>
        <h1>Una revista para pensar el presente</h1>
        <div class="dek">La Forja nace como un espacio independiente de opinión, ensayo, discusión y educación popular desde las izquierdas.</div>
        <p class="byline">Estamos preparando la primera edición y recibiendo colaboraciones.</p>
        <a class="text-link" href={base+'colabora/'}>Participa en la convocatoria →</a>
      </div>
      <EditorialArt style="constructivist" label="Pensar · discutir · formar" alt="Composición gráfica editorial de La Forja"/>
    </section>
  )}
  <section class="submission-callout" aria-labelledby="convocatoria-portada-titulo">
    <div class="submission-callout-head">
      <div>
        <span class="submission-eyebrow">Convocatoria abierta · Primera edición</span>
        <h2 id="convocatoria-portada-titulo">La Forja recibe propuestas</h2>
      </div>
      <p>Invitamos a compartir reflexiones, ideas y creaciones desde las distintas izquierdas y sensibilidades progresistas. Nos interesan tanto la discusión política como sus expresiones culturales.</p>
    </div>
    <div class="submission-callout-formats">
      <article>
        <span class="submission-format-label">01 / Opinión</span>
        <h3>Columnas</h3>
        <strong>700 a 1.200 <small>palabras</small></strong>
        <p>Intervenciones breves sobre política, sociedad, cultura y actualidad.</p>
      </article>
      <article>
        <span class="submission-format-label">02 / Reflexión</span>
        <h3>Ensayos</h3>
        <strong>Más de 2.000 <small>y hasta 5.000 palabras</small></strong>
        <p>Argumentos y reflexiones de mayor desarrollo, sin depender de la coyuntura.</p>
      </article>
      <article>
        <span class="submission-format-label">03 / Creación</span>
        <h3>Otros aportes</h3>
        <strong>Formato abierto</strong>
        <p>Poesía, artes, crónicas, propuestas culturales y otras formas de expresión.</p>
      </article>
    </div>
    <div class="submission-callout-bottom">
      <p>Las extensiones son orientativas, no excluyentes. También recibimos propuestas de educación popular.</p>
      <a href={base+'colabora/'}>Presenta tu propuesta <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="editorial-home" aria-labelledby="editorial-home-title">
    <div class="editorial-home-head">
      <div>
        <span class="label blue">Declaración editorial</span>
        <h2 id="editorial-home-title">Pensar nuestro tiempo es una tarea compartida</h2>
      </div>
      <p>Queremos que quienes no suelen encontrar canales para publicar sus reflexiones tengan aquí la oportunidad de compartirlas y encontrar personas que quieran discutir, conversar, compartir.</p>
    </div>
    <details class="editorial-home-details">
      <summary>Leer la declaración editorial completa</summary>
      <div class="editorial-home-copy">
        <DeclaracionEditorial />
      </div>
    </details>
    <a class="text-link" href={base+'sobre/'}>Visitar Sobre La Forja →</a>
  </section>
  <section class="grid3">
    {columnas.length ? (
      <article class="card"><span class="label">Columnas</span><div class="card-list">{columnas.map(c=><a href={hrefFor(c)}><strong>{c.data.title}</strong><br/><small>Por {authorName(c.data.author)}</small></a>)}</div></article>
    ) : (
      <article class="card"><span class="label">En preparación</span><h2>La primera edición</h2><p>Reuniremos columnas y ensayos sobre problemas políticos, económicos, sociales y culturales de nuestro tiempo.</p></article>
    )}
    <article class="card"><span class="label blue">Nuestra propuesta</span><h2>Por qué nace La Forja</h2><p>Las ideas políticas nos pertenecen a todos. Un espacio abierto para distintas voces, experiencias y sensibilidades de las izquierdas.</p><a class="text-link" href={base+'sobre/'}>Leer nuestra declaración →</a></article>
    <article class="card"><span class="label">Educación popular</span><h2>Cuadernos populares</h2><p>Preparamos materiales de autoformación. El primero abordará la política y los sistemas políticos.</p><a class="text-link" href={base+'educacion-popular/'}>Conocer el proyecto →</a></article>
  </section>
  {cuadernos.length>0 && <section>
    <div class="section-intro"><div><span class="label blue">Educación popular</span><h2>Cuadernos</h2></div><p>Herramientas para la autoformación política y social.</p></div>
    <div class="books">{cuadernos.map(c=><a class:list={['book','book-'+c.data.artStyle]} href={base+'educacion-popular/'}><span class="num">N.º {String(c.data.number).padStart(2,'0')}</span><span class="book-art" aria-hidden="true"></span><h3>{c.data.title}</h3><small>{c.data.series}</small></a>)}</div>
  </section>}
</BaseLayout>
