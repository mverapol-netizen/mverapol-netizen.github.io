---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Cuadernos populares" active="Educación popular">
  <header class="page-head">
    <span class="label blue">Cuadernos populares</span>
    <h1>Próximamente</h1>
    <p>Cuadernos breves de autoformación para acercarse a conceptos, problemas y debates políticos fundamentales.</p>
  </header>

  <div class="education-index">
    <article class="edu-card edu-constructivist">
      <div class="edu-cover">
        <span class="num">Próximamente</span>
        <span class="edu-art" aria-hidden="true"></span>
        <h2>La política y los sistemas políticos</h2>
        <small>Cuadernos populares · La Forja</small>
      </div>

      <div class="edu-copy">
        <h3>Cuaderno popular sobre la política y los sistemas políticos</h3>
        <p>Estamos preparando una serie de cuadernos de autoformación sobre distintos conceptos, problemas y debates fundamentales para comprender las diferentes formas de pensar la política y aprender a analizar los sistemas políticos.</p>
        <span>¡Pronto habrá más novedades!</span>
      </div>
    </article>
  </div>
</BaseLayout>
