---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const cuadernos=(await getCollection('cuadernos',({data})=>!data.draft)).sort((a,b)=>a.data.number-b.data.number);
---
<BaseLayout title="Educación popular" active="Educación popular"><header class="page-head"><span class="label blue">Educación popular</span><h1>Cuadernos de La Forja</h1><p>Conceptos, historia, lecturas y herramientas para una formación política crítica y colectiva.</p></header><div class="education-index">{cuadernos.map(c=><article class:list={['edu-card',`edu-${c.data.artStyle}`]}><div class="edu-cover"><span class="num">N.º {String(c.data.number).padStart(2,'0')}</span><span class="edu-art" aria-hidden="true"></span><h2>{c.data.title}</h2><small>Cuadernos de La Forja · {c.data.series}</small></div><div class="edu-copy"><h3>{c.data.title}</h3><p>{c.data.subtitle}</p><span>{c.data.author}</span></div></article>)}</div></BaseLayout>