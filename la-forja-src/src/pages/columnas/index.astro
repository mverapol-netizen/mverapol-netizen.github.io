---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL;
const autores=await getCollection('autores',({data})=>!data.draft);
const authorName=(id)=>autores.find(a=>a.id===id)?.data.name??id;
const columnas=(await getCollection('articulos',({data})=>data.type==='columna'&&!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Columnas" active="Columnas" noindex={columnas.length===0}>
<header class="page-head"><span class="label">Columnas</span><h1>Columnas</h1><p>Intervenciones breves sobre coyuntura, cultura y política.</p></header>
<section class="list">
  {columnas.length===0 && <article class="card"><h2>Columnas en preparación</h2><p>Estamos recibiendo textos para la primera edición. Aún no hay columnas publicadas.</p><a class="text-link" href={base+'colabora/'}>Participa en la convocatoria →</a></article>}
  {columnas.map(c=><article class="row"><strong>{c.data.date.toLocaleDateString('es-CL')}</strong><div><h2><a href={base+'columnas/'+c.id+'/'}>{c.data.title}</a></h2><p>{c.data.subtitle}</p><small>Por {authorName(c.data.author)}</small></div></article>)}
</section>
</BaseLayout>
