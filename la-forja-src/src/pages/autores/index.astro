---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL;
const autores=(await getCollection('autores',({data})=>!data.draft)).sort((a,b)=>a.data.name.localeCompare(b.data.name,'es'));
---
<BaseLayout title="Autores" noindex={autores.length===0}>
<header class="page-head"><span class="label blue">Autores</span><h1>Autores</h1><p>Quienes escriben y colaboran en La Forja.</p></header>
<section class="list">
  {autores.length===0 && <article class="card"><h2>Perfiles en preparación</h2><p>Los perfiles se incorporarán junto con las primeras publicaciones.</p><a class="text-link" href={base+'colabora/'}>Publica con nosotros →</a></article>}
  {autores.map(a=><article class="row"><strong>{a.data.name.slice(0,1)}</strong><div><h2><a href={base+'autores/'+a.id+'/'}>{a.data.name}</a></h2><p>{a.data.bio}</p>{a.data.location&&<small>{a.data.location}</small>}</div></article>)}
</section>
</BaseLayout>
