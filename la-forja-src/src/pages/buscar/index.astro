---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base=import.meta.env.BASE_URL;
const articulos=await getCollection('articulos',({data})=>!data.draft);
const autores=await getCollection('autores',({data})=>!data.draft);
const cuadernos=await getCollection('cuadernos',({data})=>!data.draft);
const authorName=(id)=>autores.find(a=>a.id===id)?.data.name??id;
const index=[
  ...articulos.map(a=>({title:a.data.title,subtitle:a.data.subtitle??'',type:a.data.type,meta:`${authorName(a.data.author)} · ${a.data.topics.join(' · ')}`,url:base+(a.data.type==='ensayo'?'ensayos/':'columnas/')+a.id+'/',search:[a.data.title,a.data.subtitle??'',authorName(a.data.author),...a.data.topics].join(' ').toLowerCase()})),
  ...cuadernos.map(c=>({title:c.data.title,subtitle:c.data.subtitle??'',type:'cuaderno',meta:`${c.data.series} · ${c.data.author}`,url:base+'educacion-popular/',search:[c.data.title,c.data.subtitle??'',c.data.series,c.data.author].join(' ').toLowerCase()}))
];
---
<BaseLayout title="Buscar" active="Buscar" noindex={articulos.length===0 && cuadernos.length===0}><header class="page-head"><span class="label">Hemeroteca</span><h1>Buscar</h1><p>Busca por título, autor, concepto o tema en las publicaciones disponibles.</p></header><section class="search-zone"><label for="search-input">Buscar en La Forja</label><input id="search-input" class="search-input" type="search" placeholder="Ej.: clase, democracia, vivienda…" autocomplete="off"/><div id="search-count" class="search-count">Escribe al menos dos caracteres.</div><div id="search-results" class="search-results"></div></section><script define:vars={{index}}>
const input=document.getElementById('search-input');const results=document.getElementById('search-results');const count=document.getElementById('search-count');const escapeHtml=(s)=>s.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();if(q.length<2){results.innerHTML='';count.textContent='Escribe al menos dos caracteres.';return;}const words=q.split(/\s+/).filter(Boolean);const found=index.filter(item=>words.every(w=>item.search.includes(w))).slice(0,30);count.textContent=found.length===1?'1 resultado':`${found.length} resultados`;results.innerHTML=found.map(item=>`<a class="search-result" href="${item.url}"><span>${escapeHtml(item.type)}</span><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.subtitle)}</p><small>${escapeHtml(item.meta)}</small></a>`).join('');});
</script></BaseLayout>