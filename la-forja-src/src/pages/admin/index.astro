---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const supabaseUrl='https://jtgoumydocaleucuomaw.supabase.co';
const supabaseKey='sb_publishable_jHVTZ5v1aeP82CxMg33r6g_S3C_yG9H';
const issues=(await getCollection('numeros',({data})=>!data.draft&&data.status==='actual')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const currentIssue=String(issues[0]?.data.number??1).padStart(3,'0');
---
<BaseLayout title="Panel editorial" noindex>
  <section class="admin-shell">
    <header class="admin-head">
      <div>
        <span class="label blue">Uso interno</span>
        <h1>Panel editorial</h1>
        <p>Recepción y revisión de colaboraciones de La Forja.</p>
      </div>
      <div class="admin-head-actions">
        <div id="admin-new-notice" class="admin-new-notice" hidden>
          <strong id="admin-new-count">0</strong>
          <span>nuevas</span>
          <button id="admin-mark-seen" type="button">Marcar vistas</button>
        </div>
        <button id="admin-logout" class="admin-logout" type="button" hidden>Cerrar sesión</button>
      </div>
    </header>

    <section id="admin-login" class="admin-login">
      <div>
        <span class="kicker">Acceso restringido</span>
        <h2>Ingresar a la redacción</h2>
        <p>Usa la cuenta de administración autorizada en Supabase. Las demás cuentas, aunque puedan autenticarse, no tienen acceso a las postulaciones.</p>
      </div>
      <form id="admin-login-form" onsubmit="return false">
        <label><span>Correo</span><input name="email" type="email" required autocomplete="username"/></label>
        <label><span>Contraseña</span><input name="password" type="password" required minlength="8" autocomplete="current-password"/></label>
        <button type="submit">Ingresar →</button>
        <p id="admin-login-status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section id="admin-app" class="admin-app" hidden>
      <div class="admin-stats">
        <button data-filter="all" class="active"><span id="count-all">0</span><strong>Todas</strong></button>
        <button data-filter="received"><span id="count-received">0</span><strong>Recibidas</strong></button>
        <button data-filter="reviewing"><span id="count-reviewing">0</span><strong>En revisión</strong></button>
        <button data-filter="accepted"><span id="count-accepted">0</span><strong>Aceptadas</strong></button>
        <button data-filter="rejected"><span id="count-rejected">0</span><strong>Rechazadas</strong></button>
        <button data-filter="published"><span id="count-published">0</span><strong>Publicadas</strong></button>
      </div>

      <div class="admin-toolbar">
        <input id="admin-search" type="search" placeholder="Buscar por título, nombre o correo…" />
        <select id="admin-priority-filter" aria-label="Filtrar por prioridad">
          <option value="all">Todas las prioridades</option>
          <option value="urgent">Urgentes</option>
          <option value="high">Altas</option>
          <option value="normal">Normales</option>
          <option value="low">Bajas</option>
        </select>
        <select id="admin-sort" aria-label="Ordenar propuestas">
          <option value="priority">Prioridad + antigüedad</option>
          <option value="oldest">Más antiguas</option>
          <option value="newest">Más recientes</option>
        </select>
        <button id="admin-refresh" type="button">Actualizar</button>
      </div>

      <div class="admin-workspace">
        <section class="admin-list-panel">
          <div id="admin-list" class="admin-list"></div>
          <div id="admin-empty" class="admin-empty" hidden>No hay propuestas en esta vista.</div>
        </section>

        <article id="admin-detail" class="admin-detail">
          <div class="admin-detail-empty">Selecciona una propuesta para revisarla.</div>
        </article>
      </div>
    </section>
  </section>

  <script define:vars={{supabaseUrl,supabaseKey,currentIssue}}>
    const STORAGE_KEY='laforja_editorial_session_v1';
    const SEEN_KEY='laforja_editorial_last_seen_v1';
    const loginSection=document.getElementById('admin-login');
    const appSection=document.getElementById('admin-app');
    const loginForm=document.getElementById('admin-login-form');
    const loginStatus=document.getElementById('admin-login-status');
    const logoutBtn=document.getElementById('admin-logout');
    const newNotice=document.getElementById('admin-new-notice');
    const newCountEl=document.getElementById('admin-new-count');
    const markSeenBtn=document.getElementById('admin-mark-seen');
    const listEl=document.getElementById('admin-list');
    const emptyEl=document.getElementById('admin-empty');
    const detailEl=document.getElementById('admin-detail');
    const searchEl=document.getElementById('admin-search');
    const refreshBtn=document.getElementById('admin-refresh');
    const priorityFilterEl=document.getElementById('admin-priority-filter');
    const sortEl=document.getElementById('admin-sort');
    const filterButtons=[...document.querySelectorAll('.admin-stats button')];
    let submissions=[];
    let currentFilter='all';
    let selectedId=null;
    let session=null;
    const versionsCache={};

    const escapeHtml=(s='')=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
    const fmtDate=(v)=>new Intl.DateTimeFormat('es-CL',{dateStyle:'medium',timeStyle:'short'}).format(new Date(v));
    const statusName=(s)=>({received:'Recibida',reviewing:'En revisión',accepted:'Aceptada',rejected:'Rechazada',withdrawn:'Retirada',published:'Publicada'})[s]||s;
    const typeName=(s)=>({columna:'Columna',ensayo:'Ensayo',debate:'Debate','educacion-popular':'Educación popular',otro:'Otro'})[s]||s;
    const priorityName=(s)=>({low:'Baja',normal:'Normal',high:'Alta',urgent:'Urgente'})[s]||'Normal';
    const priorityWeight=(s)=>({low:1,normal:2,high:3,urgent:4})[s]||2;
    const eventName=(s)=>({
      status_change:'Cambio de estado',
      priority_change:'Cambio de prioridad',
      note_update:'Nota editorial',
      publication_prep:'Preparación de publicación',
      response_draft:'Respuesta al autor',
      response_sent:'Respuesta marcada como enviada',
      version_added:'Nueva versión del manuscrito',
      publication_version:'Versión de publicación',
      manual:'Nota de historial'
    })[s]||s;
    const slugify=(s='')=>String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')||'texto';
    const yaml=(s='')=>JSON.stringify(String(s));
    const lastSeen=()=>localStorage.getItem(SEEN_KEY)||'1970-01-01T00:00:00.000Z';
    const isNew=(x)=>new Date(x.created_at)>new Date(lastSeen());

    const isArticleType=(x)=>['columna','ensayo','otro'].includes(x.contribution_type);
    const topicsFor=(x)=>Array.isArray(x.publication_topics)?x.publication_topics:[];
    const imageYaml=(x)=>{
      if(!x.publication_image)return '';
      return '\nimage: '+yaml(x.publication_image)+'\nimageAlt: '+yaml(x.publication_image_alt||'')+'\nimageCredit: '+yaml(x.publication_image_credit||'')+'\nimageTreatment: "bw"';
    };

    function manuscriptFor(x,versionNumber){
      if(Number(versionNumber)===1)return x.manuscript||'';
      const versions=versionsCache[x.id]||[];
      return versions.find(v=>Number(v.version_number)===Number(versionNumber))?.manuscript||x.manuscript||'';
    }

    function markdownFor(x){
      const date=new Date().toISOString().slice(0,10);
      const manuscript=manuscriptFor(x,x.publication_manuscript_version||1);
      const words=(manuscript||'').trim().split(/\s+/).filter(Boolean).length;
      const readingTime=Math.max(1,Math.ceil(words/220));
      const authorSlug=x.publication_author_slug||slugify(x.name);
      const issue=x.publication_issue||currentIssue;
      const artStyle=x.publication_art_style||'constructivist';
      const artLabel=x.publication_art_label||'';

      if(x.contribution_type==='debate'){
        return '---\n' +
          'draft: true\n' +
          'title: '+yaml(x.title)+'\n' +
          'subtitle: '+yaml(x.summary)+'\n' +
          'date: '+date+'\n' +
          'issue: '+yaml(issue)+'\n' +
          'participants: ['+yaml(x.name)+']\n' +
          'artStyle: '+yaml(artStyle)+'\n' +
          'artLabel: '+yaml(artLabel)+imageYaml(x)+'\n---\n\n' + (manuscript||'').trim() + '\n';
      }

      if(x.contribution_type==='educacion-popular'){
        return '---\n' +
          'draft: true\n' +
          'number: '+String(x.publication_number||0)+'\n' +
          'title: '+yaml(x.title)+'\n' +
          'subtitle: '+yaml(x.summary)+'\n' +
          'author: '+yaml(x.name)+'\n' +
          'series: '+yaml(x.publication_series||'Por definir')+'\n' +
          'date: '+date+'\n' +
          'issue: '+yaml(issue)+'\n' +
          'artStyle: '+yaml(artStyle)+'\n' +
          'artLabel: '+yaml(artLabel)+imageYaml(x)+'\n---\n\n' + (manuscript||'').trim() + '\n';
      }

      const type=x.contribution_type==='columna'?'columna':'ensayo';
      return '---\n' +
        'draft: true\n' +
        'title: '+yaml(x.title)+'\n' +
        'subtitle: '+yaml(x.summary)+'\n' +
        'author: '+yaml(authorSlug)+'\n' +
        'type: '+yaml(type)+'\n' +
        'date: '+date+'\n' +
        'issue: '+yaml(issue)+'\n' +
        'topics: '+JSON.stringify(topicsFor(x))+'\n' +
        'featured: '+String(!!x.publication_featured)+'\n' +
        'readingTime: '+String(readingTime)+'\n' +
        'artStyle: '+yaml(artStyle)+'\n' +
        'artLabel: '+yaml(artLabel)+imageYaml(x)+'\n---\n\n' + (manuscript||'').trim() + '\n';
    }

    function authorMarkdownFor(x){
      return '---\n' +
        'draft: true\n' +
        'name: '+yaml(x.name)+'\n' +
        'bio: '+yaml(x.bio)+'\n' +
        '---\n';
    }

    function markdownFilename(x){return slugify(x.title)+'.md'}
    function authorFilename(x){return (x.publication_author_slug||slugify(x.name))+'.md'}
    function suggestedPath(x){
      if(x.contribution_type==='debate')return 'src/content/debates/'+markdownFilename(x);
      if(x.contribution_type==='educacion-popular')return 'src/content/cuadernos/'+markdownFilename(x);
      return 'src/content/articulos/'+markdownFilename(x);
    }
    function suggestedAuthorPath(x){return 'src/content/autores/'+authorFilename(x)}

    async function copyText(text,message){
      await navigator.clipboard.writeText(text);
      const el=document.getElementById('export-status');if(el)el.textContent=message;
    }
    function downloadText(text,filename,message){
      const blob=new Blob([text],{type:'text/markdown;charset=utf-8'});
      const url=URL.createObjectURL(blob);
      const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);
      const el=document.getElementById('export-status');if(el)el.textContent=message;
    }

    function publicationPanel(x){
      if(!['accepted','published'].includes(x.status))return '';
      const article=isArticleType(x);
      const edu=x.contribution_type==='educacion-popular';
      const authorSlug=x.publication_author_slug||slugify(x.name);
      const issue=x.publication_issue||currentIssue;
      const topics=topicsFor(x).join(', ');
      const style=x.publication_art_style||'constructivist';
      return `
        <section class="admin-publication">
          <header><div><span>Preparación de publicación</span><h3>Ficha para GitHub</h3></div><strong id="prep-readiness"></strong></header>
          <div class="admin-pub-grid">
            <label><span>Slug del autor</span><input id="pub-author-slug" value="${escapeHtml(authorSlug)}"></label>
            <label><span>Número</span><input id="pub-issue" value="${escapeHtml(issue)}" maxlength="12"></label>
            ${article?`<label class="wide"><span>Temas</span><input id="pub-topics" value="${escapeHtml(topics)}" placeholder="clase, democracia, trabajo"></label>`:''}
            ${edu?`<label><span>N.º Cuaderno</span><input id="pub-number" type="number" min="1" value="${escapeHtml(x.publication_number||'')}"></label><label><span>Serie</span><input id="pub-series" value="${escapeHtml(x.publication_series||'')}" placeholder="Conceptos básicos"></label>`:''}
            <label><span>Tratamiento gráfico</span><select id="pub-art-style">${['crowd','constructivist','type','archive','rays'].map(v=>`<option value="${v}" ${style===v?'selected':''}>${v}</option>`).join('')}</select></label>
            <label><span>Rótulo gráfico</span><input id="pub-art-label" value="${escapeHtml(x.publication_art_label||'')}" placeholder="Clase · democracia · poder"></label>
            <label class="wide"><span>Imagen (opcional)</span><input id="pub-image" value="${escapeHtml(x.publication_image||'')}" placeholder="/images/articulos/archivo.webp"></label>
            <label><span>Texto alternativo</span><input id="pub-image-alt" value="${escapeHtml(x.publication_image_alt||'')}"></label>
            <label><span>Crédito de imagen</span><input id="pub-image-credit" value="${escapeHtml(x.publication_image_credit||'')}"></label>
            ${article?`<label class="check"><input id="pub-featured" type="checkbox" ${x.publication_featured?'checked':''}><span>Destacar en portada</span></label>`:''}
            <label class="check"><input id="pub-ready" type="checkbox" ${x.publication_ready?'checked':''}><span>Revisión editorial terminada</span></label>
          </div>
          <div id="pub-checklist" class="admin-pub-checklist"></div>
          <div class="admin-pub-actions"><button id="save-publication" type="button">Guardar ficha →</button><span id="publication-status" role="status"></span></div>
        </section>
        <section class="admin-export">
          <div>
            <span>Borradores para GitHub</span>
            <strong>${escapeHtml(suggestedPath(x))}</strong>
            <small>${escapeHtml(suggestedAuthorPath(x))}</small>
            <p>Los dos archivos se generan siempre con <code>draft: true</code>.</p>
          </div>
          <div class="admin-export-actions">
            <button id="copy-markdown" type="button">Copiar texto</button>
            <button id="download-markdown" type="button">Descargar texto .md</button>
            <button id="copy-author" type="button">Copiar autor</button>
            <button id="download-author" type="button">Descargar autor .md</button>
            <span id="export-status" role="status"></span>
          </div>
        </section>`;
    }

    function collectPublicationForm(x){
      const topics=document.getElementById('pub-topics');
      const number=document.getElementById('pub-number');
      const series=document.getElementById('pub-series');
      return {
        publication_author_slug:(document.getElementById('pub-author-slug')?.value||slugify(x.name)).trim(),
        publication_issue:(document.getElementById('pub-issue')?.value||currentIssue).trim(),
        publication_topics:topics?topics.value.split(',').map(v=>v.trim()).filter(Boolean):topicsFor(x),
        publication_art_style:document.getElementById('pub-art-style')?.value||'constructivist',
        publication_art_label:(document.getElementById('pub-art-label')?.value||'').trim()||null,
        publication_image:(document.getElementById('pub-image')?.value||'').trim()||null,
        publication_image_alt:(document.getElementById('pub-image-alt')?.value||'').trim()||null,
        publication_image_credit:(document.getElementById('pub-image-credit')?.value||'').trim()||null,
        publication_featured:!!document.getElementById('pub-featured')?.checked,
        publication_ready:!!document.getElementById('pub-ready')?.checked,
        publication_series:series?series.value.trim()||null:x.publication_series||null,
        publication_number:number&&number.value?Number(number.value):x.publication_number||null
      };
    }

    function updatePrepChecklist(x){
      const host=document.getElementById('pub-checklist');if(!host)return;
      const p=collectPublicationForm(x);
      const items=[
        ['Autor identificado',!!p.publication_author_slug],
        ['Número asignado',!!p.publication_issue],
        ['Tratamiento gráfico',!!p.publication_art_style]
      ];
      if(isArticleType(x))items.push(['Al menos un tema',p.publication_topics.length>0]);
      if(x.contribution_type==='educacion-popular'){items.push(['Número de Cuaderno',Number(p.publication_number)>0]);items.push(['Serie definida',!!p.publication_series]);}
      if(p.publication_image){items.push(['Texto alternativo de imagen',!!p.publication_image_alt]);items.push(['Crédito de imagen',!!p.publication_image_credit]);}
      items.push(['Revisión editorial terminada',!!p.publication_ready]);
      const ok=items.filter(i=>i[1]).length;
      host.innerHTML=items.map(i=>'<span class="'+(i[1]?'done':'pending')+'">'+(i[1]?'✓':'○')+' '+escapeHtml(i[0])+'</span>').join('');
      const badge=document.getElementById('prep-readiness');if(badge){badge.textContent=ok+'/'+items.length+' listos';badge.className=ok===items.length?'ready':'pending';}
    }

    async function logEvent(submissionId,eventType,{fromValue=null,toValue=null,note=null}={}){
      try{
        await api('editorial_submission_events',{
          method:'POST',
          headers:{'Content-Type':'application/json','Prefer':'return=minimal'},
          body:JSON.stringify({
            submission_id:submissionId,
            event_type:eventType,
            from_value:fromValue,
            to_value:toValue,
            note,
            actor_email:session?.user?.email||null
          })
        });
      }catch{}
    }

    function versionPanel(x){
      return `
        <section class="admin-versions">
          <header>
            <div><span>Revisión del manuscrito</span><h3>Versiones</h3></div>
            <strong>Publicación: V${Number(x.publication_manuscript_version||1)}</strong>
          </header>
          <div id="version-summary" class="version-summary"><p>Cargando versiones…</p></div>
          <div class="version-controls">
            <label><span>Comparar</span><select id="compare-a"></select></label>
            <label><span>con</span><select id="compare-b"></select></label>
            <button id="use-publication-version" type="button">Usar B para publicación</button>
            <span id="version-action-status"></span>
          </div>
          <div id="version-compare" class="version-compare"></div>
          <details class="version-add">
            <summary>Añadir una nueva versión</summary>
            <div class="version-add-form">
              <label><span>Origen</span>
                <select id="revision-source">
                  <option value="author">Versión corregida del autor/a</option>
                  <option value="editorial">Edición interna</option>
                </select>
              </label>
              <label><span>Nota de revisión</span><input id="revision-note" maxlength="5000" placeholder="Qué cambió en esta versión"></label>
              <label class="wide"><span>Manuscrito revisado</span><textarea id="revision-manuscript" rows="18" minlength="100" maxlength="120000"></textarea></label>
              <button id="save-version" type="button">Guardar nueva versión →</button>
              <span id="version-save-status"></span>
            </div>
          </details>
        </section>`;
    }

    function allVersionsFor(x){
      return [{
        version_number:1,
        created_at:x.created_at,
        manuscript:x.manuscript||'',
        revision_note:'Manuscrito original recibido',
        revision_source:'author',
        actor_email:x.email
      },...(versionsCache[x.id]||[])].sort((a,b)=>Number(a.version_number)-Number(b.version_number));
    }

    function versionLabel(v){
      return 'V'+v.version_number+(Number(v.version_number)===1?' · original':' · '+(v.revision_source==='editorial'?'edición interna':'revisión'));
    }

    function compareParagraphs(a,b){
      const pa=String(a||'').split(/\n\s*\n/).map(s=>s.trim()).filter(Boolean);
      const pb=String(b||'').split(/\n\s*\n/).map(s=>s.trim()).filter(Boolean);
      const setA=new Set(pa),setB=new Set(pb);
      const left=pa.map(p=>'<p class="'+(setB.has(p)?'same':'changed removed')+'">'+escapeHtml(p)+'</p>').join('');
      const right=pb.map(p=>'<p class="'+(setA.has(p)?'same':'changed added')+'">'+escapeHtml(p)+'</p>').join('');
      return '<div class="version-pane">'+left+'</div><div class="version-pane">'+right+'</div>';
    }

    function renderVersionSummary(x){
      const versions=allVersionsFor(x);
      const host=document.getElementById('version-summary');
      const a=document.getElementById('compare-a');
      const b=document.getElementById('compare-b');
      if(!host||!a||!b)return;
      host.innerHTML=versions.map(v=>`
        <article class="${Number(v.version_number)===Number(x.publication_manuscript_version||1)?'is-publication':''}">
          <strong>${escapeHtml(versionLabel(v))}</strong>
          <span>${escapeHtml(fmtDate(v.created_at))}</span>
          <p>${escapeHtml(v.revision_note||'Sin nota de revisión.')}</p>
        </article>`).join('');
      const options=versions.map(v=>`<option value="${v.version_number}">${escapeHtml(versionLabel(v))}</option>`).join('');
      a.innerHTML=options;b.innerHTML=options;
      a.value=String(versions.length>1?versions[versions.length-2].version_number:1);
      b.value=String(versions[versions.length-1].version_number);
      renderVersionComparison(x);
    }

    function renderVersionComparison(x){
      const a=document.getElementById('compare-a');
      const b=document.getElementById('compare-b');
      const host=document.getElementById('version-compare');
      if(!a||!b||!host)return;
      const va=Number(a.value),vb=Number(b.value);
      host.innerHTML=compareParagraphs(manuscriptFor(x,va),manuscriptFor(x,vb));
    }

    async function loadVersions(id){
      const x=submissions.find(s=>s.id===id);if(!x)return;
      try{
        const r=await api('editorial_submission_versions?submission_id=eq.'+encodeURIComponent(id)+'&select=id,version_number,created_at,manuscript,revision_note,revision_source,actor_email&order=version_number.asc');
        if(!r.ok)throw new Error('versions');
        versionsCache[id]=await r.json();
        renderVersionSummary(x);
      }catch{
        const host=document.getElementById('version-summary');if(host)host.innerHTML='<p>No se pudieron cargar las versiones.</p>';
      }
    }

    async function saveNewVersion(id){
      const x=submissions.find(s=>s.id===id);if(!x)return;
      const text=document.getElementById('revision-manuscript')?.value?.trim()||'';
      const note=document.getElementById('revision-note')?.value?.trim()||null;
      const source=document.getElementById('revision-source')?.value||'author';
      const status=document.getElementById('version-save-status');
      if(text.length<100){status.textContent='El manuscrito debe tener al menos 100 caracteres.';return;}
      const versions=allVersionsFor(x);
      const next=Math.max(...versions.map(v=>Number(v.version_number)))+1;
      status.textContent='Guardando V'+next+'…';
      try{
        const r=await api('editorial_submission_versions',{
          method:'POST',
          headers:{'Content-Type':'application/json','Prefer':'return=minimal'},
          body:JSON.stringify({
            submission_id:id,
            version_number:next,
            manuscript:text,
            revision_note:note,
            revision_source:source,
            actor_email:session?.user?.email||null
          })
        });
        if(!r.ok)throw new Error('save-version');
        await logEvent(id,'version_added',{toValue:'V'+next,note:note||'Nueva versión incorporada.'});
        document.getElementById('revision-manuscript').value='';
        document.getElementById('revision-note').value='';
        await loadVersions(id);
        status.textContent='V'+next+' guardada.';
        loadHistory(id);
      }catch{status.textContent='No se pudo guardar la versión.'}
    }

    async function setPublicationVersion(id){
      const x=submissions.find(s=>s.id===id);if(!x)return;
      const target=Number(document.getElementById('compare-b')?.value||1);
      const status=document.getElementById('version-action-status');
      const old=Number(x.publication_manuscript_version||1);
      if(target===old){status.textContent='Esa versión ya está seleccionada.';return;}
      status.textContent='Guardando…';
      try{
        const now=new Date().toISOString();
        const r=await api('editorial_submissions?id=eq.'+encodeURIComponent(id),{
          method:'PATCH',
          headers:{'Content-Type':'application/json','Prefer':'return=minimal'},
          body:JSON.stringify({publication_manuscript_version:target,updated_at:now})
        });
        if(!r.ok)throw new Error('publication-version');
        x.publication_manuscript_version=target;x.updated_at=now;
        await logEvent(id,'publication_version',{fromValue:'V'+old,toValue:'V'+target});
        renderDetail(id);
      }catch{status.textContent='No se pudo cambiar la versión de publicación.'}
    }

    function responseText(x,kind,note=''){
      const extra=String(note||'').trim();
      if(kind==='accept'){
        return `Hola ${x.name},

Gracias por enviar “${x.title}” a La Forja. Hemos revisado el texto y queremos avanzar con su publicación.

${extra?extra+'\n\n':''}Antes de publicarlo podremos proponer ajustes de edición, título, bajada o presentación para adecuarlo al formato de la revista. La aceptación editorial no implica una publicación inmediata: coordinaremos la versión final antes de incorporarla a un número de La Forja.

Gracias por confiar en nosotros.

Equipo editorial
La Forja`;
      }
      if(kind==='reject'){
        return `Hola ${x.name},

Gracias por enviar “${x.title}” a La Forja y por confiar en la revista.

Después de revisarlo, hemos decidido no avanzar con su publicación en esta oportunidad.

${extra?extra+'\n\n':''}Esta decisión se refiere a este texto y a las necesidades editoriales actuales de la revista; no impide que puedas enviarnos nuevas propuestas en el futuro.

Gracias nuevamente por escribirnos.

Equipo editorial
La Forja`;
      }
      return `Hola ${x.name},

Gracias por enviar “${x.title}” a La Forja. Hemos revisado el texto y nos interesa seguir trabajando en él, pero antes de tomar una decisión final quisiéramos pedir algunos cambios.

${extra||'En la nota editorial indicaremos los ajustes que consideramos necesarios.'}

Cuando tengas una nueva versión, podremos revisarla nuevamente.

Gracias por la disposición al diálogo editorial.

Equipo editorial
La Forja`;
    }

    function responsePanel(x){
      const kind=x.author_response_kind||(
        ['accepted','published'].includes(x.status)?'accept':
        x.status==='rejected'?'reject':'revise'
      );
      const note=x.author_response_note||'';
      return `
        <section class="admin-response">
          <header><div><span>Comunicación editorial</span><h3>Respuesta al autor</h3></div>${x.response_sent_at?`<strong>Enviada · ${escapeHtml(fmtDate(x.response_sent_at))}</strong>`:''}</header>
          <div class="admin-response-grid">
            <label><span>Tipo de respuesta</span>
              <select id="response-kind">
                <option value="accept" ${kind==='accept'?'selected':''}>Aceptación</option>
                <option value="revise" ${kind==='revise'?'selected':''}>Solicitar cambios</option>
                <option value="reject" ${kind==='reject'?'selected':''}>Rechazo</option>
              </select>
            </label>
            <label><span>Mensaje específico</span><textarea id="response-note" rows="5" maxlength="10000" placeholder="Argumentos, observaciones o cambios solicitados…">${escapeHtml(note)}</textarea></label>
          </div>
          <div id="response-preview" class="admin-response-preview"></div>
          <div class="admin-response-actions">
            <button id="save-response" type="button">Guardar respuesta</button>
            <button id="copy-response" type="button">Copiar respuesta</button>
            <button id="mark-response-sent" type="button">Marcar enviada</button>
            <span id="response-status" role="status"></span>
          </div>
        </section>`;
    }

    function updateResponsePreview(x){
      const host=document.getElementById('response-preview');if(!host)return;
      const kind=document.getElementById('response-kind')?.value||'revise';
      const note=document.getElementById('response-note')?.value||'';
      host.textContent=responseText(x,kind,note);
    }

    async function saveResponse(id){
      const x=submissions.find(s=>s.id===id);if(!x)return;
      const kind=document.getElementById('response-kind').value;
      const note=document.getElementById('response-note').value.trim()||null;
      const msg=document.getElementById('response-status');
      msg.textContent='Guardando…';
      try{
        const r=await api('editorial_submissions?id=eq.'+encodeURIComponent(id),{
          method:'PATCH',
          headers:{'Content-Type':'application/json','Prefer':'return=minimal'},
          body:JSON.stringify({author_response_kind:kind,author_response_note:note,updated_at:new Date().toISOString()})
        });
        if(!r.ok)throw new Error('save-response');
        const oldKind=x.author_response_kind;
        x.author_response_kind=kind;x.author_response_note=note;
        await logEvent(id,'response_draft',{fromValue:oldKind,toValue:kind,note});
        msg.textContent='Respuesta guardada.';
        loadHistory(id);
      }catch{msg.textContent='No se pudo guardar.'}
    }

    async function markResponseSent(id){
      const x=submissions.find(s=>s.id===id);if(!x)return;
      const when=new Date().toISOString();
      const kind=document.getElementById('response-kind')?.value||x.author_response_kind||'revise';
      const note=document.getElementById('response-note')?.value?.trim()||x.author_response_note||null;
      const msg=document.getElementById('response-status');
      msg.textContent='Guardando…';
      try{
        const r=await api('editorial_submissions?id=eq.'+encodeURIComponent(id),{
          method:'PATCH',
          headers:{'Content-Type':'application/json','Prefer':'return=minimal'},
          body:JSON.stringify({author_response_kind:kind,author_response_note:note,response_sent_at:when,updated_at:when})
        });
        if(!r.ok)throw new Error('sent');
        Object.assign(x,{author_response_kind:kind,author_response_note:note,response_sent_at:when});
        await logEvent(id,'response_sent',{toValue:kind,note:'Respuesta marcada como enviada.'});
        renderDetail(id);
      }catch{msg.textContent='No se pudo marcar como enviada.'}
    }

    async function loadHistory(id){
      const host=document.getElementById('admin-history-list');if(!host)return;
      host.innerHTML='<p>Cargando historial…</p>';
      try{
        const r=await api('editorial_submission_events?submission_id=eq.'+encodeURIComponent(id)+'&select=id,created_at,event_type,from_value,to_value,note,actor_email&order=created_at.desc');
        if(!r.ok)throw new Error('history');
        const events=await r.json();
        host.innerHTML=events.length?events.map(e=>`
          <article>
            <time>${escapeHtml(fmtDate(e.created_at))}</time>
            <div><strong>${escapeHtml(eventName(e.event_type))}</strong>
              ${e.from_value||e.to_value?`<small>${escapeHtml(e.from_value||'—')} → ${escapeHtml(e.to_value||'—')}</small>`:''}
              ${e.note?`<p>${escapeHtml(e.note)}</p>`:''}
            </div>
          </article>`).join(''):'<p>Aún no hay eventos registrados para esta propuesta.</p>';
      }catch{host.innerHTML='<p>No se pudo cargar el historial.</p>'}
    }

    function renderNewNotice(){
      const count=submissions.filter(isNew).length;
      newCountEl.textContent=count;
      newNotice.hidden=count===0;
    }

    function readSession(){
      try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||'null')}catch{return null}
    }
    function saveSession(value){
      session=value;
      if(value)localStorage.setItem(STORAGE_KEY,JSON.stringify(value));
      else localStorage.removeItem(STORAGE_KEY);
    }
    function jwtExp(token){
      try{return JSON.parse(atob(token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))).exp||0}catch{return 0}
    }
    async function refreshSession(){
      if(!session?.refresh_token)return false;
      const r=await fetch(`${supabaseUrl}/auth/v1/token?grant_type=refresh_token`,{
        method:'POST',headers:{apikey:supabaseKey,'Content-Type':'application/json'},
        body:JSON.stringify({refresh_token:session.refresh_token})
      });
      if(!r.ok){saveSession(null);return false}
      const next=await r.json();saveSession(next);return true;
    }
    async function ensureSession(){
      session=readSession();
      if(!session?.access_token)return false;
      if(jwtExp(session.access_token) < Math.floor(Date.now()/1000)+60){
        return await refreshSession();
      }
      return true;
    }
    async function api(path,options={}){
      if(!(await ensureSession()))throw new Error('auth');
      const headers={apikey:supabaseKey,Authorization:`Bearer ${session.access_token}`,...(options.headers||{})};
      return fetch(`${supabaseUrl}/rest/v1/${path}`,{...options,headers});
    }
    async function loadSubmissions(){
      refreshBtn.disabled=true;
      try{
        const fields='id,created_at,status,name,email,contribution_type,title,summary,bio,manuscript,notes,editorial_note,reviewed_at,updated_at,publication_author_slug,publication_issue,publication_topics,publication_art_style,publication_art_label,publication_image,publication_image_alt,publication_image_credit,publication_featured,publication_ready,publication_series,publication_number,publication_manuscript_version,manuscript_file_path,manuscript_file_name,manuscript_file_size,editorial_priority,author_response_kind,author_response_note,response_sent_at';
        const r=await api(`editorial_submissions?select=${fields}&order=created_at.desc`);
        if(r.status===401||r.status===403)throw new Error('forbidden');
        if(!r.ok)throw new Error('load');
        submissions=await r.json();
        renderStats();renderNewNotice();renderList();
        if(selectedId && submissions.some(x=>x.id===selectedId))renderDetail(selectedId);
      }catch(error){
        if(error.message==='auth'||error.message==='forbidden'){logout(false);loginStatus.textContent='La sesión no tiene autorización para acceder a la redacción.'}
        else emptyEl.textContent='No fue posible cargar las propuestas.';
      }finally{refreshBtn.disabled=false}
    }
    function renderStats(){
      const count=(status)=>status==='all'?submissions.length:submissions.filter(x=>x.status===status).length;
      ['all','received','reviewing','accepted','rejected','published'].forEach(s=>{
        const el=document.getElementById(`count-${s}`);if(el)el.textContent=count(s);
      });
    }
    function visibleItems(){
      const q=searchEl.value.trim().toLowerCase();
      const priorityFilter=priorityFilterEl.value;
      const items=submissions.filter(x=>
        (currentFilter==='all'||x.status===currentFilter) &&
        (priorityFilter==='all'||(x.editorial_priority||'normal')===priorityFilter) &&
        (!q||[x.title,x.name,x.email,x.summary].join(' ').toLowerCase().includes(q))
      );
      const mode=sortEl.value;
      return [...items].sort((a,b)=>{
        if(mode==='oldest')return new Date(a.created_at)-new Date(b.created_at);
        if(mode==='newest')return new Date(b.created_at)-new Date(a.created_at);
        const pd=priorityWeight(b.editorial_priority)-priorityWeight(a.editorial_priority);
        return pd||new Date(a.created_at)-new Date(b.created_at);
      });
    }
    function renderList(){
      const items=visibleItems();
      emptyEl.hidden=items.length>0;
      listEl.innerHTML=items.map(x=>`
        <button class="admin-list-item ${x.id===selectedId?'selected':''} ${isNew(x)?'is-new':''}" data-id="${x.id}">
          <div class="admin-list-top"><span class="admin-status status-${escapeHtml(x.status)}">${escapeHtml(statusName(x.status))}</span><span class="admin-priority priority-${escapeHtml(x.editorial_priority||'normal')}">${escapeHtml(priorityName(x.editorial_priority||'normal'))}</span>${isNew(x)?'<span class="admin-new-dot">Nueva</span>':''}</div>
          <strong>${escapeHtml(x.title)}</strong>
          <small>${escapeHtml(x.name)} · ${escapeHtml(typeName(x.contribution_type))}</small>
          <time>${escapeHtml(fmtDate(x.created_at))}</time>
        </button>`).join('');
      listEl.querySelectorAll('[data-id]').forEach(btn=>btn.addEventListener('click',()=>{selectedId=btn.dataset.id;renderList();renderDetail(selectedId)}));
    }
    async function downloadOriginalWord(x){
      if(!x.manuscript_file_path)return;
      const btn=document.getElementById('download-word');
      const msg=document.getElementById('word-download-status');
      if(btn)btn.disabled=true;
      if(msg)msg.textContent='Descargando…';
      try{
        if(!(await ensureSession()))throw new Error('auth');
        const encoded=x.manuscript_file_path.split('/').map(encodeURIComponent).join('/');
        const r=await fetch(`${supabaseUrl}/storage/v1/object/authenticated/editorial-manuscripts/${encoded}`,{
          headers:{apikey:supabaseKey,Authorization:`Bearer ${session.access_token}`}
        });
        if(!r.ok)throw new Error('download');
        const blob=await r.blob();
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');
        a.href=url;
        a.download=x.manuscript_file_name||'manuscrito.docx';
        document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);
        if(msg)msg.textContent='Word descargado.';
      }catch{
        if(msg)msg.textContent='No se pudo descargar el Word.';
      }finally{
        if(btn)btn.disabled=false;
      }
    }

    function renderDetail(id){
      const x=submissions.find(s=>s.id===id);if(!x)return;
      detailEl.innerHTML=`
        <header class="admin-detail-head">
          <div><span class="admin-status status-${escapeHtml(x.status)}">${escapeHtml(statusName(x.status))}</span><h2>${escapeHtml(x.title)}</h2><p>${escapeHtml(x.name)} · <a href="mailto:${escapeHtml(x.email)}">${escapeHtml(x.email)}</a></p></div>
          <div><span>${escapeHtml(typeName(x.contribution_type))}</span><time>${escapeHtml(fmtDate(x.created_at))}</time></div>
        </header>
        <section class="admin-meta">
          <div><strong>Resumen</strong><p>${escapeHtml(x.summary)}</p></div>
          <div><strong>Biografía</strong><p>${escapeHtml(x.bio)}</p></div>
          ${x.notes?`<div><strong>Nota de quien envía</strong><p>${escapeHtml(x.notes)}</p></div>`:''}
        </section>
        ${x.manuscript_file_path?`
        <section class="admin-word-file">
          <div>
            <span>Word original</span>
            <strong>${escapeHtml(x.manuscript_file_name||'manuscrito.docx')}</strong>
            <small>${x.manuscript_file_size?escapeHtml((x.manuscript_file_size/1024/1024).toFixed(2)+' MB'):''}</small>
          </div>
          <button id="download-word" type="button">Descargar Word original →</button>
          <span id="word-download-status" role="status"></span>
        </section>`:''}
        <section class="admin-manuscript"><strong>${x.manuscript_file_path?'Vista de lectura extraída del Word · V1':'Descripción de la propuesta · V1'}</strong><div>${escapeHtml(x.manuscript).replace(/\n/g,'<br>')}</div></section>
        ${versionPanel(x)}
        ${publicationPanel(x)}
        <section class="admin-review">
          <label><span>Prioridad editorial</span>
            <select id="detail-priority">
              ${['urgent','high','normal','low'].map(p=>`<option value="${p}" ${(x.editorial_priority||'normal')===p?'selected':''}>${priorityName(p)}</option>`).join('')}
            </select>
          </label>
          <label><span>Estado editorial</span>
            <select id="detail-status">
              ${['received','reviewing','accepted','rejected','withdrawn','published'].map(s=>`<option value="${s}" ${x.status===s?'selected':''}>${statusName(s)}</option>`).join('')}
            </select>
          </label>
          <label><span>Nota interna</span><textarea id="detail-note" rows="6" maxlength="10000" placeholder="Observaciones para la redacción…">${escapeHtml(x.editorial_note||'')}</textarea></label>
          <div class="admin-review-actions"><button id="save-review" type="button">Guardar revisión →</button><span id="save-status" role="status"></span></div>
        </section>
        ${responsePanel(x)}
        <section class="admin-history">
          <header><span>Expediente</span><h3>Historial editorial</h3></header>
          <div id="admin-history-list"></div>
        </section>`;
      document.getElementById('save-review').addEventListener('click',()=>saveReview(x.id));
      const downloadWordBtn=document.getElementById('download-word');
      if(downloadWordBtn)downloadWordBtn.addEventListener('click',()=>downloadOriginalWord(x));
      const copyBtn=document.getElementById('copy-markdown');
      const downloadBtn=document.getElementById('download-markdown');
      const copyAuthorBtn=document.getElementById('copy-author');
      const downloadAuthorBtn=document.getElementById('download-author');
      const savePublicationBtn=document.getElementById('save-publication');
      if(copyBtn)copyBtn.addEventListener('click',()=>copyText(markdownFor(x),'Markdown del texto copiado.'));
      if(downloadBtn)downloadBtn.addEventListener('click',()=>downloadText(markdownFor(x),markdownFilename(x),'Texto descargado.'));
      if(copyAuthorBtn)copyAuthorBtn.addEventListener('click',()=>copyText(authorMarkdownFor(x),'Ficha de autor copiada.'));
      if(downloadAuthorBtn)downloadAuthorBtn.addEventListener('click',()=>downloadText(authorMarkdownFor(x),authorFilename(x),'Ficha de autor descargada.'));
      if(savePublicationBtn){
        savePublicationBtn.addEventListener('click',()=>savePublicationPrep(x.id));
        detailEl.querySelectorAll('.admin-publication input,.admin-publication select').forEach(el=>el.addEventListener('input',()=>updatePrepChecklist(x)));
        updatePrepChecklist(x);
      }
      const compareA=document.getElementById('compare-a');
      const compareB=document.getElementById('compare-b');
      const saveVersionBtn=document.getElementById('save-version');
      const useVersionBtn=document.getElementById('use-publication-version');
      if(compareA)compareA.addEventListener('change',()=>renderVersionComparison(x));
      if(compareB)compareB.addEventListener('change',()=>renderVersionComparison(x));
      if(saveVersionBtn)saveVersionBtn.addEventListener('click',()=>saveNewVersion(x.id));
      if(useVersionBtn)useVersionBtn.addEventListener('click',()=>setPublicationVersion(x.id));
      loadVersions(x.id);

      const responseKind=document.getElementById('response-kind');
      const responseNote=document.getElementById('response-note');
      const saveResponseBtn=document.getElementById('save-response');
      const copyResponseBtn=document.getElementById('copy-response');
      const markResponseBtn=document.getElementById('mark-response-sent');
      if(responseKind)responseKind.addEventListener('change',()=>updateResponsePreview(x));
      if(responseNote)responseNote.addEventListener('input',()=>updateResponsePreview(x));
      if(saveResponseBtn)saveResponseBtn.addEventListener('click',()=>saveResponse(x.id));
      if(copyResponseBtn)copyResponseBtn.addEventListener('click',async()=>{
        await navigator.clipboard.writeText(responseText(x,responseKind.value,responseNote.value));
        document.getElementById('response-status').textContent='Respuesta copiada.';
      });
      if(markResponseBtn)markResponseBtn.addEventListener('click',()=>markResponseSent(x.id));
      updateResponsePreview(x);
      loadHistory(x.id);
    }
    async function savePublicationPrep(id){
      const x=submissions.find(s=>s.id===id);if(!x)return;
      const btn=document.getElementById('save-publication');const msg=document.getElementById('publication-status');
      const payload=collectPublicationForm(x);
      btn.disabled=true;msg.textContent='Guardando ficha…';
      try{
        const now=new Date().toISOString();
        const r=await api('editorial_submissions?id=eq.'+encodeURIComponent(id),{
          method:'PATCH',headers:{'Content-Type':'application/json','Prefer':'return=minimal'},
          body:JSON.stringify({...payload,updated_at:now})
        });
        if(!r.ok)throw new Error('save-prep');
        Object.assign(x,payload,{updated_at:now});
        await logEvent(id,'publication_prep',{note:'Ficha de preparación editorial actualizada.'});
        renderDetail(id);
        const fresh=document.getElementById('publication-status');if(fresh)fresh.textContent='Ficha guardada.';
      }catch{msg.textContent='No se pudo guardar la ficha.'}finally{btn.disabled=false}
    }

    async function saveReview(id){
      const btn=document.getElementById('save-review');const msg=document.getElementById('save-status');
      const status=document.getElementById('detail-status').value;
      const priority=document.getElementById('detail-priority').value;
      const editorial_note=document.getElementById('detail-note').value.trim()||null;
      const x=submissions.find(s=>s.id===id);
      const oldStatus=x?.status;
      const oldPriority=x?.editorial_priority||'normal';
      const oldNote=x?.editorial_note||null;
      btn.disabled=true;msg.textContent='Guardando…';
      try{
        const now=new Date().toISOString();
        const r=await api(`editorial_submissions?id=eq.${encodeURIComponent(id)}`,{
          method:'PATCH',headers:{'Content-Type':'application/json','Prefer':'return=minimal'},
          body:JSON.stringify({status,editorial_priority:priority,editorial_note,reviewed_at:now,updated_at:now})
        });
        if(!r.ok)throw new Error('save');
        if(x){x.status=status;x.editorial_priority=priority;x.editorial_note=editorial_note;x.reviewed_at=now;x.updated_at=now}
        const events=[];
        if(oldStatus!==status)events.push(logEvent(id,'status_change',{fromValue:oldStatus,toValue:status}));
        if(oldPriority!==priority)events.push(logEvent(id,'priority_change',{fromValue:oldPriority,toValue:priority}));
        if(oldNote!==editorial_note)events.push(logEvent(id,'note_update',{note:editorial_note||'Nota editorial eliminada.'}));
        await Promise.allSettled(events);
        renderStats();renderNewNotice();renderList();renderDetail(id);document.getElementById('save-status').textContent='Guardado.';
      }catch{msg.textContent='No se pudo guardar.'}finally{btn.disabled=false}
    }
    function showApp(){
      loginSection.hidden=true;appSection.hidden=false;logoutBtn.hidden=false;loadSubmissions();
    }
    function logout(showMessage=true){
      saveSession(null);submissions=[];selectedId=null;appSection.hidden=true;logoutBtn.hidden=true;loginSection.hidden=false;
      if(showMessage)loginStatus.textContent='Sesión cerrada.';
    }

    loginForm.addEventListener('submit',async(e)=>{
      e.preventDefault();loginStatus.textContent='Ingresando…';
      const fd=new FormData(loginForm);const email=String(fd.get('email')||'').trim();const password=String(fd.get('password')||'');
      try{
        const r=await fetch(`${supabaseUrl}/auth/v1/token?grant_type=password`,{
          method:'POST',headers:{apikey:supabaseKey,'Content-Type':'application/json'},body:JSON.stringify({email,password})
        });
        if(!r.ok)throw new Error('login');
        saveSession(await r.json());loginForm.reset();loginStatus.textContent='';showApp();
      }catch{loginStatus.textContent='No fue posible ingresar. Revisa las credenciales.'}
    });
    logoutBtn.addEventListener('click',()=>logout());
    markSeenBtn.addEventListener('click',()=>{
      localStorage.setItem(SEEN_KEY,new Date().toISOString());
      renderNewNotice();renderList();
    });
    refreshBtn.addEventListener('click',loadSubmissions);
    searchEl.addEventListener('input',renderList);
    priorityFilterEl.addEventListener('change',renderList);
    sortEl.addEventListener('change',renderList);
    filterButtons.forEach(btn=>btn.addEventListener('click',()=>{currentFilter=btn.dataset.filter;filterButtons.forEach(b=>b.classList.toggle('active',b===btn));renderList()}));

    ensureSession().then(ok=>{if(ok)showApp();}).catch(()=>{loginStatus.textContent="No fue posible comprobar la sesión.";});
  </script>
</BaseLayout>