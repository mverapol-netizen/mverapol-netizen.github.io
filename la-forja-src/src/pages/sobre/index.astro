---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeclaracionEditorial from '../../components/DeclaracionEditorial.astro';
---
<BaseLayout title="Sobre La Forja" description="Declaración editorial de La Forja: un espacio de pensamiento, discusión y creación intelectual y cultural desde las distintas izquierdas y sensibilidades progresistas.">
  <header class="page-head">
    <span class="label blue">La revista</span>
    <h1>Sobre La Forja</h1>
    <p>Pensar nuestro tiempo es una tarea compartida.</p>
  </header>
  <section class="article">
    <div class="article-body">
      <DeclaracionEditorial />
      <aside class="pull">Herederos de una posta larga</aside>
    </div>
  </section>
</BaseLayout>
