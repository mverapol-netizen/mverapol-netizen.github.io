---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialArt from '../../components/EditorialArt.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const entries=await getCollection('articulos',({data})=>data.type==='ensayo');return entries.map(post=>({params:{slug:post.id},props:{post}}))}
const{post}=Astro.props;
const base=import.meta.env.BASE_URL;
const slugify=(s)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const autores=await getCollection('autores');
const author=autores.find(a=>a.id===post.data.author);
const{Content}=await render(post);
---
<BaseLayout title={post.data.title} description={post.data.subtitle} active="Ensayos">
  <article class="article">
    <header>
      <span class="label blue">Ensayo</span>
      <h1>{post.data.title}</h1>
      <div class="dek">{post.data.subtitle}</div>
      <div class="byline">Por {author?.data.name??post.data.author} · {post.data.date.toLocaleDateString('es-CL')} {post.data.readingTime&&`· ${post.data.readingTime} min`}</div>
    </header>
    <EditorialArt style={post.data.artStyle} label={post.data.artLabel} alt={post.data.title}/>
    {post.data.imageCredit && <div class="image-credit">{post.data.imageCredit}</div>}
    <section class="article-body">
      <div class="prose"><Content/></div>
      <aside class="pull">La democracia política no puede separarse indefinidamente de la distribución del poder económico.</aside>
    </section>
    <section class="article-topics"><strong>Temas</strong>{post.data.topics.map(t=><a href={base+'temas/'+slugify(t)+'/' }>{t}</a>)}</section>
  </article>
</BaseLayout>