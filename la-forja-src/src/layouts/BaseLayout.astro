---
import '../styles/global.css';
interface Props{title?:string;description?:string;active?:string}
const{title='La Forja',description='Revista de opinión, pensamiento crítico, debate y educación popular.',active=''}=Astro.props;
const base=import.meta.env.BASE_URL;
const nav=[['Portada',''],['Columnas','columnas/'],['Ensayos','ensayos/'],['Debates','debates/'],['Educación popular','educacion-popular/'],['Archivo','archivo/']];
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title==='La Forja'?title:`${title} — La Forja`}</title></head><body><main class="shell"><div class="topline"><span>Año I · N.º 1 · Santiago de Chile</span><span>Octubre de 2026</span></div><header class="mast"><a class="logo" href={base}>La Forja</a><div class="mast-note">Opinión<br/>Pensamiento crítico<br/>Debate<br/>Educación popular</div></header><nav class="nav">{nav.map(([label,path])=><a class:list={{active:active===label}} href={base+path}>{label}</a>)}<a class="push" href="mailto:redaccion@laforja.cl?subject=Colaboración%20La%20Forja">Colabora</a></nav><slot/><footer><span>La Forja · Santiago de Chile · 2026</span><span>Opinión · Debate · Educación popular</span></footer></main></body></html>