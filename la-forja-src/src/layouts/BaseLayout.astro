---
import '../styles/global.css';
import { getCollection } from 'astro:content';
interface Props{
  title?:string;description?:string;active?:string;image?:string;
  type?:'website'|'article';publishedTime?:Date;author?:string;noindex?:boolean;
}
const{
  title='La Forja',
  description='Revista de opinión, pensamiento crítico, debate y educación popular.',
  active='',image,type='website',publishedTime,author,noindex=false
}=Astro.props;
const base=import.meta.env.BASE_URL;
const pageTitle=title==='La Forja'?title:`${title} — La Forja`;
const canonical=new URL(Astro.url.pathname,Astro.site);
const socialImage=new URL(image ? (image.startsWith('/')?base+image.replace(/^\//,''):image) : base+'social/default.svg',Astro.site);
const rssUrl=new URL(base+'rss.xml',Astro.site);
const issues=(await getCollection('numeros',({data})=>!data.draft&&data.status==='actual')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const current=issues[0];
const roman=['','I','II','III','IV','V','VI','VII','VIII','IX','X'];
const yearLabel=current ? (roman[current.data.year]??String(current.data.year)) : 'I';
const issueNumber=current?.data.number??1;
const issueMonth=current?.data.month??'';
const nav=[['Portada',''],['Columnas','columnas/'],['Ensayos','ensayos/'],['Educación popular','educacion-popular/'],['Archivo','archivo/'],['Temas','temas/'],['Buscar','buscar/']];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#e8ddc4"/>
  {noindex && <meta name="robots" content="noindex,nofollow,noarchive"/>}
  <link rel="canonical" href={canonical}/>
  <link rel="alternate" type="application/rss+xml" title="La Forja" href={rssUrl}/>
  <meta property="og:site_name" content="La Forja"/>
  <meta property="og:locale" content="es_CL"/>
  <meta property="og:type" content={type}/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={socialImage}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={pageTitle}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={socialImage}/>
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()}/>}
  {author && <meta name="author" content={author}/>}
  <title>{pageTitle}</title>
</head>
<body class="page-enter">
  <main class="shell">
    <div class="topline"><span>Año {yearLabel} · N.º {issueNumber} · Santiago de Chile</span><span>{issueMonth}</span></div>
    <header class="mast">
      <a class="logo ink-title" href={base}>La Forja</a>
      <div class="mast-side">
        <div class="mast-note">Opinión<br/>Pensamiento crítico<br/>Debate<br/>Educación popular</div>
        <a class="mast-submit" href={base+'colabora/'}>
          <span>Convocatoria editorial</span>
          <strong>Publica con nosotros →</strong>
        </a>
      </div>
    </header>
    <nav class="nav">
      {nav.map(([label,path])=><a class:list={{active:active===label}} href={base+path}>{label}</a>)}
      <a class="nav-submit" href={base+'colabora/'}>Publica con nosotros</a>
    </nav>
    <slot/>
    <footer>
      <span>La Forja · Santiago de Chile · 2026</span>
      <span><a href={base+'autores/'}>Autores</a> · <a href={base+'temas/'}>Temas</a> · <a href={base+'buscar/'}>Buscar</a> · <a href={rssUrl}>RSS</a> · <a href={base+'sobre/'}>Sobre La Forja</a> · <a class="footer-submit" href={base+'colabora/'}>Publica con nosotros</a></span>
    </footer>
  </main>
  <script is:inline>
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      document.addEventListener('click', (event) => {
        const a = event.target.closest('a');
        if (!a || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (a.target === '_blank' || a.hasAttribute('download')) return;
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
        const url = new URL(a.href, window.location.href);
        if (url.origin !== window.location.origin) return;
        event.preventDefault();
        document.body.classList.add('page-leave');
        window.setTimeout(() => { window.location.href = url.href; }, 115);
      });
    })();
  </script>
</body>
</html>