---
interface Props{
  style?:'crowd'|'constructivist'|'type'|'archive'|'rays';
  label?:string;
  alt?:string;
  href?:string;
  compact?:boolean;
  image?:string;
  imageAlt?:string;
  imageTreatment?:'bw'|'red'|'blue'|'natural';
}
const {style='constructivist',label='',alt='',href,compact=false,image,imageAlt='',imageTreatment='bw'}=Astro.props;
const Tag=href?'a':'div';
const base=import.meta.env.BASE_URL;
const src=image ? (image.startsWith('/') ? base+image.replace(/^\//,'') : image) : undefined;
---
<Tag class:list={['editorial-art',`art-${style}`,{'art-compact':compact,'has-image':!!image},image&&`image-${imageTreatment}`]} href={href} aria-label={href ? (alt || imageAlt || label || 'Abrir publicación') : undefined}>
  {image ? <img class="editorial-image" src={src} alt={imageAlt || alt || ''} loading={compact?'lazy':'eager'} /> : <span class="art-field" aria-hidden="true"></span>}
  {label && <span class="art-caption">{label}</span>}
</Tag>